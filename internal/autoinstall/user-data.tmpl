#cloud-config
# The Subiquity seed for den. `den usb build` renders this and puts it on the
# install image. Secrets are injected at build time, never stored here.
#
# WARNING: the storage stanza pins the install to the NVMe. The four hard
# drives must never be candidates. Any change here is a review stop.
autoinstall:
  version: 1
  # Autoinstall takes one locale. LC_TIME is overridden in a late-command.
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: America/Los_Angeles
  updates: security
  # Otherwise 26.04 sizes and reserves a crash kernel out of the 64G.
  kernel-crash-dumps:
    enabled: false
  apt:
    # One named mirror, so the installer has no candidate list to probe.
    mirror-selection:
      primary:
        - uri: http://us.archive.ubuntu.com/ubuntu
    geoip: false
  network:
    network:
      version: 2
      ethernets:
        all-en:
          match:
            name: "en*"
          dhcp4: true
  storage:
    config:
      - type: disk
        id: nvme
        path: /dev/nvme0n1
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
      - type: partition
        id: esp
        device: nvme
        number: 1
        size: 1G
        flag: boot
        grub_device: true
      # /boot stays outside LUKS. GRUB has to read the kernel before anything
      # is unlocked, and Ubuntu's GRUB cannot open a LUKS2 argon2id header.
      - type: partition
        id: boot
        device: nvme
        number: 2
        size: 2G
      # Subiquity resolves a negative size to the rest of the disk, but only
      # on the last partition. curtin itself has no such form, so this must
      # stay the final entry.
      - type: partition
        id: root-part
        device: nvme
        number: 3
        size: -1
      # curtin takes the passphrase only in clear, and copies the seed onto
      # the installed system. Wipe the USB stick after the install.
      - type: dm_crypt
        id: root-crypt
        dm_name: den-root
        volume: root-part
        key: {{ .LUKSPassphrase | quote }}
      - type: format
        id: esp-fs
        volume: esp
        fstype: fat32
      - type: format
        id: boot-fs
        volume: boot
        fstype: ext4
      - type: format
        id: root-fs
        volume: root-crypt
        fstype: btrfs
      - type: mount
        id: root-mount
        device: root-fs
        path: /
      - type: mount
        id: boot-mount
        device: boot-fs
        path: /boot
      - type: mount
        id: esp-mount
        device: esp-fs
        path: /boot/efi
  identity:
    hostname: {{ .Hostname }}
    realname: {{ .Username }}
    username: {{ .Username }}
    password: {{ .PasswordHash | quote }}
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
{{- range .AuthorizedKeys }}
      - {{ . | quote }}
{{- end }}
  packages:
    - avahi-daemon
    - curl
    - git
    - gnupg
    - systemd-cryptsetup
    - tpm2-tools
  # Enrolling the TPM here would seal to PCR 7 as the installer's own boot
  # chain measured it, so the work is deferred to the installed system.
  late-commands:
    - |
      cat > /target/usr/local/sbin/den-tpm-enroll <<'SCRIPT'
      #!/bin/bash
      set -euo pipefail

      key=/etc/den/luks.key

      # Stay enabled after an unexpected failure so the next boot retries and
      # the journal keeps a record. Only a decided outcome turns it off, and
      # the key file survives until enrollment actually succeeds.
      done_with_it() { shred -u "$key" 2>/dev/null || true; systemctl disable den-tpm-enroll.service; }

      if [ ! -e /dev/tpmrm0 ]; then
        echo "no TPM: the passphrase stays the only way in"
        done_with_it
        exit 0
      fi

      # An unknown crypttab option can leave the root volume unopenable, so
      # confirm the initramfs understands one before writing it.
      if ! lsinitramfs "/boot/initrd.img-$(uname -r)" | grep -q systemd-cryptsetup; then
        echo "this initramfs cannot unlock with a TPM: leaving crypttab alone"
        done_with_it
        exit 0
      fi

      if [ ! -s "$key" ]; then
        echo "no passphrase at $key: cannot enroll"
        done_with_it
        exit 0
      fi

      src=$(awk '!/^#/ && NF {print $2; exit}' /etc/crypttab)
      case "$src" in
        UUID=*) dev=/dev/disk/by-uuid/${src#UUID=} ;;
        *) dev=$src ;;
      esac

      systemd-cryptenroll --unlock-key-file="$key" \
        --tpm2-device=auto --tpm2-pcrs=7 "$dev"

      awk '/^#/ || NF == 0 { print; next }
           $0 ~ /tpm2-device=/ { print; next }
           { $4 = (NF < 4 || $4 == "none") ? "tpm2-device=auto" : $4 ",tpm2-device=auto"; print }' \
        /etc/crypttab > /etc/crypttab.new
      mv /etc/crypttab.new /etc/crypttab
      update-initramfs -u

      done_with_it
      echo "TPM enrolled: the passphrase is now the recovery path only"
      SCRIPT
    - chmod 0755 /target/usr/local/sbin/den-tpm-enroll
    - install -d -m 0700 /target/etc/den
    - install -m 0600 {{ seedKey }} /target/etc/den/luks.key
    - |
      cat > /target/etc/systemd/system/den-tpm-enroll.service <<'UNIT'
      [Unit]
      Description=Enroll the TPM to unlock the root volume
      ConditionPathExists=/etc/den/luks.key

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/den-tpm-enroll
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target
      UNIT
    - curtin in-target --target=/target -- systemctl enable den-tpm-enroll.service
    # Passwordless sudo is a bootstrap dependency of the automation, not
    # ordinary config: without it the first `den apply` cannot install the file
    # that removes the password prompt. mgmt owns the same path afterwards, so
    # keep the two byte for byte identical or every run will rewrite it.
    #
    # A malformed file in sudoers.d breaks sudo for everyone, so it is checked
    # before it is installed, and never written in place.
    - |
      set -euo pipefail
      printf '%s ALL=(ALL) NOPASSWD: ALL\n' '{{ .Username }}' > /tmp/den-sudoers
      visudo -cf /tmp/den-sudoers
      install -m 0440 -o root -g root /tmp/den-sudoers /target/etc/sudoers.d/den
    # GRUB defaults and locales used to be written here. They are ordinary
    # config, not disk shape, so mgmt owns them now: see mgmt/main.mcl. A fresh
    # install boots with a 30 second recordfail pause and the wrong LC_TIME
    # until the first `den apply`, which is a cosmetic gap and a deliberate one.
    # curtin has no subvolume action, so the layout is rebuilt here. This must
    # stay the last late-command: it reads the finished tree out of /target.
    - |
      cat > /tmp/den-subvols <<'SCRIPT'
      #!/bin/bash
      set -euo pipefail

      # Work through a second mount of the top level. /target has /boot and the
      # pseudo-filesystems mounted over it, and those must not be touched.
      top=/tmp/den-btrfs-top
      dev=$(findmnt -no SOURCE /target)
      mkdir -p "$top"
      mount -o subvolid=5 "$dev" "$top"

      # btrfs refuses to snapshot a subvolume holding a swapfile, so curtin's
      # own swapfile goes before the snapshot and comes back in @swap.
      rm -f "$top/swap.img"

      # A snapshot moves the tree into @ by metadata alone, with no copy and
      # no chance of losing ownership or extended attributes along the way.
      btrfs subvolume snapshot "$top" "$top/@"

      btrfs subvolume create "$top/@swap"
      chattr +C "$top/@swap"
      btrfs filesystem mkswapfile --size 8g "$top/@swap/swapfile"

      # The initramfs mounts whatever the default subvolume is, because the
      # kernel command line carries no rootflags.
      btrfs subvolume set-default "$top/@"

      mkdir -p "$top/@/swap"

      fstab=$top/@/etc/fstab
      awk '
        $2 == "/" && $3 == "btrfs" { rootspec = $1; $4 = $4 ",subvol=@" }
        $1 == "/swap.img" { next }
        { print }
        END {
          print rootspec, "/swap", "btrfs", "defaults,subvol=@swap", 0, 0
          print "/swap/swapfile", "none", "swap", "sw", 0, 0
        }
      ' "$fstab" > "$fstab.new"
      mv "$fstab.new" "$fstab"

      umount "$top"
      SCRIPT
      bash /tmp/den-subvols
  shutdown: reboot
