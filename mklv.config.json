{
  "$schema": "https://raw.githubusercontent.com/dmikalova/project-standards/main/schema/mklv.config.schema.json",
  "name": "den",
  "entrypoint": "cmd/den/main.go",
  "kind": "cli",
  "tools": {
    "lefthook": {
      "pre-commit": {
        "commands": {
          "no-shell-scripts": {
            "exclude": [
              "internal/autoinstall/initrd/*.sh",
              "mgmt/**/*.sh",
              "scripts/*.sh"
            ]
          }
        }
      }
    }
  },
  "ignore": {
    "git": [
      "/bin/",
      "/build/",
      "coverage.*",
      "/den"
    ]
  }
}
