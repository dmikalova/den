# den's root layer.
#
# Only things that need root belong here. Everything den actually serves is a
# rootless Podman quadlet living in the login user's home, started by that
# user's own systemd. What root owns is the ground those quadlets stand on:
# packages, mounts, lingering, and a few one shot enablements.
#
# mgmt converges this once and exits. See docs/bootstrap.md.

import "deploy"
import "os"

# The whole host package set. If this list grows much past twenty, something
# that should be a container has leaked into the host.
pkg [
	"btrfs-progs",
	"fuse-overlayfs",
	"lm-sensors",
	"mergerfs",
	"ncurses-term",
	"nvidia-driver-595-open",
	"passt",
	"podman",
	"rsync",
	"samba",
	"smartmontools",
	"snapper",
	"snapraid",
	"systemd-zram-generator",
	"uidmap",
	"ufw",
	"unattended-upgrades",
] {
	state => "installed",
	allowunsupported => os.is_family_debian() ?: true,

	# The NVIDIA driver is in Ubuntu's restricted component, which PackageKit
	# reports as non-free. Without this it will not even resolve the name.
	allownonfree => true,

	# systemd's apt-daily.timer can hold the apt lock when this runs, and
	# PackageKit cannot wait for it. apt-daily finishes in seconds, so retry.
	Meta:retry => 3,
	Meta:delay => 15000,
}

# Sentinels for the exec resources below, which change state that is not a file.
#
# No mode: mgmt 1.1.0 compares a directory's os.FileMode, which carries ModeDir,
# against a bare octal, so the two never match and it chmods in a loop until the
# converger gives up. Fixed upstream after 1.1.0. mkdir already gives 0755.
file "/var/lib/den/" {
	state => "exists",

	# Anchors the whole den-services chain below this behind the package set.
	# Every `pkg` above merges into one autogroup, so depending on any single
	# member waits for all of them. Without this the chain races the autogroup:
	# file resources land before the package that owns their directory, and the
	# kopia and caddy installs fight that same apt run for the dpkg lock.
	Depend => Pkg["rsync"],
}

# The install asks for kernel-crash-dumps to be off and does not get it, so
# take the reservation back here. A crash dump is of no use on a host whose
# recovery plan is to rebuild it from this file.
pkg "kdump-tools" {
	state => "uninstalled",
}

# Without this, the drives expose no hwmon and their temperature can only be
# read by shelling out to smartctl.
file "/etc/modules-load.d/drivetemp.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/modules-load.d/drivetemp.conf"),
	mode => "0644",
}

# Compressed swap in RAM, on top of the disk swapfile the install lays down.
# zram takes the higher priority, so cold anonymous pages are compressed into
# RAM and the SSD is only reached once zram fills. The win is not capacity:
# it is that the kernel can evict pages nothing will touch again and give the
# memory to page cache.
file "/etc/systemd/zram-generator.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/zram-generator.conf"),
	mode => "0644",
}

# Swapping to RAM is cheap enough that the kernel should do it readily. The
# stock 60 is tuned for swap that costs a disk seek.
file "/etc/sysctl.d/99-den-swap.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/sysctl.d/99-den-swap.conf"),
	mode => "0644",
}

file "/etc/sysctl.d/99-den-rootless.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/sysctl.d/99-den-rootless.conf"),
	mode => "0644",
}

# sysctl.d is read at boot, so a new file changes nothing on a running system.
# Bump the sentinel after editing either file to apply it without a reboot.
exec "sysctl-reload-v1" {
	cmd => "sysctl --system >/dev/null && touch /var/lib/den/sysctl-reload-v1",
	shell => "/bin/bash",
	creates => "/var/lib/den/sysctl-reload-v1",

	Depend => File["/etc/sysctl.d/99-den-rootless.conf"],
}

# GRUB's stock recordfail pause is 30 seconds, which a headless box spends
# waiting for a keystroke nobody is there to press.
#
# Deliberately no ahci.mask_port_map. Cheap SATA cards sometimes advertise far
# more ports than they wire up and the kernel wastes minutes probing phantom
# ones, but the card fitted here reports its 8 real ports honestly, and a mask
# would only discard working ports. It is also global: it hits the chipset's
# own controller too. Measure before ever reintroducing it:
#   journalctl -k | grep -E 'masking port_map|ports implemented'
file "/etc/default/grub.d/99-den.cfg" {
	state => "exists",
	content => deploy.readfile("/files/etc/default/grub.d/99-den.cfg"),
	mode => "0644",
}

# grub.cfg is generated, so writing the drop-in is only half the job. The mtime
# comparison reruns this whenever the drop-in is newer and never otherwise,
# which also makes it safe if mgmt orders the file write after this exec.
exec "update-grub" {
	cmd => "update-grub",
	shell => "/bin/bash",
	ifcmd => "! test /boot/grub/grub.cfg -nt /etc/default/grub.d/99-den.cfg",
	ifshell => "/bin/bash",
}

# en_DK is the ISO 8601 locale: 24 hour clock and YYYY-MM-DD dates. Only
# LC_TIME takes it, so messages stay in English.
exec "locales-v1" {
	cmd => "locale-gen en_US.UTF-8 en_DK.UTF-8 && update-locale LC_TIME=en_DK.UTF-8 && touch /var/lib/den/locales-v1",
	shell => "/bin/bash",
	creates => "/var/lib/den/locales-v1",
}

# The install writes this too, because den cannot reach mgmt without it. mgmt
# keeps it from drifting. The content must match the installer's exactly.
file "/etc/sudoers.d/den" {
	state => "exists",
	content => deploy.readfile("/files/etc/sudoers.d/den"),
	mode => "0440",
}

# Without lingering, the login user's quadlets stop at logout and never come
# back after a reboot. Nothing reports this; the services are simply absent.
exec "enable-linger" {
	cmd => "loginctl enable-linger dmikalova",
	shell => "/bin/bash",
	creates => "/var/lib/systemd/linger/dmikalova",
}

# The autoinstall only builds @ and @swap, because those two have to exist
# before the tree is snapshotted into place. The rest are ordinary subvolumes
# and are cheapest to create while /home is still nearly empty.
#
# The split is what makes a snapper rollback of / safe: without @home, rolling
# the root subvolume back takes the home directory with it.
exec "btrfs-subvols-v1" {
	cmd => deploy.readfile("/files/scripts/btrfs-subvols.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/btrfs-subvols-v1",

	Depend => Pkg["rsync"],
}

file "/etc/systemd/system/home.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/home.mount"),
	mode => "0644",
}

file "/etc/systemd/system/home-dmikalova-.local-share-containers.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/home-dmikalova-.local-share-containers.mount"),
	mode => "0644",
}

file "/etc/systemd/system/srv-appdata.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/srv-appdata.mount"),
	mode => "0644",
}

file "/etc/systemd/system/srv-models.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/srv-models.mount"),
	mode => "0644",
}

# Mount units rather than fstab entries: fstab is written by the installer with
# install-time UUIDs, so mgmt owning it would fight a rebuild. /dev/mapper/den-root
# is named by the autoinstall template, which is in this repo, so it is stable.
exec "btrfs-mounts-v1" {
	cmd => deploy.readfile("/files/scripts/btrfs-mounts.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/btrfs-mounts-v1",

	Depend => Exec["btrfs-subvols-v1"],
}

# The bulk storage: three btrfs data drives pooled with mergerfs, one ext4
# parity drive for snapraid. The filesystems themselves are made by hand, once,
# because a mkfs behind a sentinel file is one lost file away from erasing the
# array.
#
# Drives are named by /dev/disk/by-id so that a controller reorder cannot swap
# a data drive for the parity drive.
file "/etc/systemd/system/mnt-disk1.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/mnt-disk1.mount"),
	mode => "0644",

	Depend => Exec["btrfs-mounts-v1"],
}

file "/etc/systemd/system/mnt-disk2.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/mnt-disk2.mount"),
	mode => "0644",

	Depend => File["/etc/systemd/system/mnt-disk1.mount"],
}

file "/etc/systemd/system/mnt-disk3.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/mnt-disk3.mount"),
	mode => "0644",

	Depend => File["/etc/systemd/system/mnt-disk2.mount"],
}

file "/etc/systemd/system/mnt-parity1.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/mnt-parity1.mount"),
	mode => "0644",

	Depend => File["/etc/systemd/system/mnt-disk3.mount"],
}

# Chained to the one before it: the script below enables all five, and Depend
# carries a single reference, so a chain is what makes "all of them exist" true.
file "/etc/systemd/system/mnt-storage.mount" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/mnt-storage.mount"),
	mode => "0644",

	Depend => File["/etc/systemd/system/mnt-parity1.mount"],
}

exec "storage-mounts-v2" {
	cmd => deploy.readfile("/files/scripts/storage-mounts.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/storage-mounts-v2",

	Depend => File["/etc/systemd/system/mnt-storage.mount"],
}

# Snapshots of /, /home and /srv/appdata. Must run after the mounts: each config
# is created against a subvolume, and an unmounted /srv/appdata is just a
# directory on @.
#
# No grub-btrfs. It is not packaged for this release, so it would mean building
# a bootloader generator from source, and /boot is a separate ext4 partition
# here, so a snapshot entry would pair an old root with the current kernel
# anyway. Rollback is a rescue-USB job: mount subvolid=5 and promote a snapshot.
#
# Nothing enables the snapper timers, because the package already does, and
# create-config appends to SNAPPER_CONFIGS itself. Bump the sentinel to reapply
# the tuning after editing the script.
exec "snapper-configs-v2" {
	cmd => deploy.readfile("/files/scripts/snapper-configs.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/snapper-configs-v2",

	Depend => Exec["storage-mounts-v2"],
}

# Parity for the pooled drives. snapraid is not a backup and does not pretend
# to be: it follows a deletion to parity on the next sync. What it buys is that
# losing one drive costs nothing, which for 36 TB of bulk data is the difference
# between an inconvenience and a restore from B2 measured in days.
file "/etc/snapraid.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/snapraid.conf"),
	mode => "0644",

	Depend => Exec["snapper-configs-v2"],
}

file "/etc/systemd/system/snapraid-sync.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/snapraid-sync.service"),
	mode => "0644",

	Depend => File["/etc/snapraid.conf"],
}

file "/etc/systemd/system/snapraid-sync.timer" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/snapraid-sync.timer"),
	mode => "0644",

	Depend => File["/etc/systemd/system/snapraid-sync.service"],
}

file "/etc/systemd/system/snapraid-scrub.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/snapraid-scrub.service"),
	mode => "0644",

	Depend => File["/etc/systemd/system/snapraid-sync.timer"],
}

# Chained like the mount units above, for the same reason.
file "/etc/systemd/system/snapraid-scrub.timer" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/snapraid-scrub.timer"),
	mode => "0644",

	Depend => File["/etc/systemd/system/snapraid-scrub.service"],
}

exec "snapraid-units-v1" {
	cmd => deploy.readfile("/files/scripts/snapraid-units.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/snapraid-units-v1",

	Depend => File["/etc/systemd/system/snapraid-scrub.timer"],
}

# The GPU.
#
# The driver is the open kernel module build, which is what NVIDIA supports on
# Ada and later. Installing it is what takes the card off nouveau; the package
# blacklists nouveau itself in /usr/lib/modprobe.d, so nothing here repeats it.
# It needs a reboot to take effect, which mgmt does not do.
#
# Containers reach the GPU through CDI rather than a runtime wrapper: the
# quadlets are rootless, and CDI is the path that does not need a privileged
# daemon to inject devices.
file "/etc/systemd/system/nvidia-cdi-refresh.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/nvidia-cdi-refresh.service"),
	mode => "0644",

	Depend => Exec["snapraid-units-v1"],
}

exec "nvidia-container-v1" {
	cmd => deploy.readfile("/files/scripts/nvidia-container.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/nvidia-container-v1",

	Depend => File["/etc/systemd/system/nvidia-cdi-refresh.service"],
}

# Ubuntu's dynamic motd is release upsell and a news feed that each login waits
# on. .hushlogin silences the whole thing, including the last login line,
# without deleting package files that an upgrade would put back.
#
# root as well as the operator: reconcile and CI log in as root.
file "/home/dmikalova/.hushlogin" {
	state => "exists",
	owner => "dmikalova",
	group => "dmikalova",
	mode => "0644",
}

file "/root/.hushlogin" {
	state => "exists",
	owner => "root",
	group => "root",
	mode => "0644",
}

# Enrolment is den apply's last step, not this one: the key cannot live in a
# public repo. This only installs the package.
exec "tailscale-v1" {
	cmd => deploy.readfile("/files/scripts/tailscale-install.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/tailscale-v1",
}

file "/etc/default/tailscaled" {
	state => "exists",
	content => deploy.readfile("/files/etc/default/tailscaled"),
	mode => "0644",
}

# tailscaled only reads its flags at start, so the file alone changes nothing.
# Bump the sentinel to restart it after editing the flags.
#
# If the TPM ever refuses to unseal, tailscaled comes up without an identity and
# den drops off the tailnet. LAN ssh is unaffected, so the way back is
# den apply --host den.local.
exec "tailscaled-flags-v1" {
	cmd => "systemctl restart tailscaled && touch /var/lib/den/tailscaled-flags-v1",
	shell => "/bin/bash",
	creates => "/var/lib/den/tailscaled-flags-v1",

	Depend => File["/etc/default/tailscaled"],
}

# Drives idle down on their own; smartd is what notices one dying first.
svc "smartd" {
	state => "running",
	startup => "enabled",
}

# Bump the sentinel version to reapply.
exec "ufw-policy-v1" {
	cmd => deploy.readfile("/files/scripts/ufw-policy.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/ufw-policy-v1",
}

# systemd already runs the upgrades, on apt-daily.timer and
# apt-daily-upgrade.timer. All that is missing is policy, and policy is a
# config file, so mgmt owns it and runs nothing itself.
file "/etc/apt/apt.conf.d/20auto-upgrades" {
	state => "exists",
	content => deploy.readfile("/files/etc/apt/apt.conf.d/20auto-upgrades"),
	mode => "0644",
}

# Stock Allowed-Origins is security only, which leaves ordinary bug fixes in
# -updates to rot. Apt appends to list options, so this widens 50unattended
# rather than replacing it. Remove-Unused does the job autoremove --purge used
# to do in bootstrap, including old kernels.
#
# Automatic-Reboot stays false until three things are true, in order:
#   1. the LUKS TPM token is confirmed bound to PCR 7 only, so a kernel update
#      cannot invalidate it and strand den at a passphrase prompt
#   2. snapper is configured AND the /boot problem is solved: /boot is a
#      separate partition, so rolling @ back to before a kernel update leaves
#      a kernel in /boot whose modules are gone from /lib/modules.
#      snapper is done. KernelCount below keeps the matching kernel in /boot,
#      so a restored root still has an entry it can boot, but picking it is a
#      human at the GRUB menu, not something that recovers on its own
#   3. a dead man notification exists to report the host did not come back.
#      Unit failures now alert through den-notify@.service, but that runs on
#      den, so it cannot report den being absent. The external healthcheck is
#      still missing, and it is the half that matters here
file "/etc/apt/apt.conf.d/52den-unattended" {
	state => "exists",
	content => deploy.readfile("/files/etc/apt/apt.conf.d/52den-unattended"),
	mode => "0644",
}

# The drift catcher.
file "/usr/local/bin/den-reconcile" {
	state => "exists",
	content => deploy.readfile("/files/usr/local/bin/den-reconcile"),
	mode => "0755",
}

file "/etc/systemd/system/den-reconcile.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-reconcile.service"),
	mode => "0644",
}

file "/etc/systemd/system/den-reconcile.timer" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-reconcile.timer"),
	mode => "0644",
}

# Not a svc resource: mgmt appends .service to the name, so it looks for
# den-reconcile.timer.service and fails.
#
# The guard is a sentinel rather than the wants symlink, which is what it used
# to be. The symlink exists after the first enable, so editing either unit
# afterwards never reloaded systemd and the old unit stayed live. Bump the
# version to pick up a unit change.
exec "den-reconcile-units-v2" {
	cmd => "systemctl daemon-reload && systemctl enable --now den-reconcile.timer && touch /var/lib/den/den-reconcile-units-v2",
	shell => "/bin/bash",
	creates => "/var/lib/den/den-reconcile-units-v2",

	Depend => File["/etc/systemd/system/den-reconcile.service"],
}

# The alerting path.
#
# Nothing on this host reports a failure to a human today: a unit can fail, the
# timer can stop firing, and the first anyone knows is when a service is needed
# and is not there. This is built before the services that will one day fail,
# because retrofitting alerting means deciding per service whether it is worth
# it, and the answer is always "later".
#
# den itself does the reporting, so the binary has to be on the host. Bump the
# version here and in den-install.sh together.
exec "den-binary-v1.9.0" {
	cmd => deploy.readfile("/files/scripts/den-install.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/den-binary-v1.9.0",

	Depend => File["/var/lib/den/"],
}

file "/etc/systemd/system/den-notify@.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-notify@.service"),
	mode => "0644",

	Depend => Exec["den-binary-v1.9.0"],
}

# No mode: see /var/lib/den/ above.
file "/etc/systemd/system/service.d/" {
	state => "exists",

	Depend => File["/etc/systemd/system/den-notify@.service"],
}

# One file that gives every service on the host, present and future, an alert
# on failure. The chain of edges above it is deliberate: mgmt runs with
# --no-autoedges, and this drop-in takes effect at the next daemon-reload, so
# a handler whose ExecStart is still missing would turn one failure into two.
file "/etc/systemd/system/service.d/10-den-onfailure.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/service.d/10-den-onfailure.conf"),
	mode => "0644",

	Depend => File["/etc/systemd/system/service.d/"],
}

# The symlink to /dev/null masks the top level drop-in for the notifier itself.
# Without it a failing notifier is a service failure, which schedules another
# notifier. systemd detects most such loops, but the manual says to break the
# chain explicitly and this is cheaper than finding out it did not.
exec "den-notify-units-v1" {
	cmd => "mkdir -p /etc/systemd/system/den-notify@.service.d && ln -sfn /dev/null /etc/systemd/system/den-notify@.service.d/10-den-onfailure.conf && systemctl daemon-reload && touch /var/lib/den/den-notify-units-v1",
	shell => "/bin/bash",
	creates => "/var/lib/den/den-notify-units-v1",

	Depend => File["/etc/systemd/system/service.d/10-den-onfailure.conf"],
}

# The secrets path.
#
# den holds exactly one credential, a service account key sealed to this
# host's TPM, and fetches everything else with it. The key is minted by the
# infrastructure repo and written here by `den apply`, so it is never in this
# repository. It does live in that repo's Terraform state, which is therefore
# as sensitive as this host.
#
# den-secrets.service explodes the fetched blob into /run/den/secrets, one
# file per key, so that a unit declares what it needs with LoadCredential= and
# systemd copies only that into the unit's own namespace. The unit file is
# therefore the allowlist, rather than a process asking for whatever it likes.

# No mode: see /var/lib/den/ above.
file "/etc/den/" {
	state => "exists",

	Depend => Exec["den-notify-units-v1"],
}

# No mode: see /var/lib/den/ above.
file "/etc/den/credentials/" {
	state => "exists",

	Depend => File["/etc/den/"],
}

file "/etc/systemd/system/den-secrets.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-secrets.service"),
	mode => "0644",

	Depend => File["/etc/den/credentials/"],
}

# Enabled but not started here. The unit needs the sealed key to exist, which
# `den apply` writes after this converge, and starting it before then would
# fail on a host that is otherwise fine. Bump the version for a unit change.
exec "den-secrets-units-v1" {
	cmd => "systemctl daemon-reload && systemctl enable den-secrets.service && touch /var/lib/den/den-secrets-units-v1",
	shell => "/bin/bash",
	creates => "/var/lib/den/den-secrets-units-v1",

	Depend => File["/etc/systemd/system/den-secrets.service"],
}

# The offsite copy.
#
# snapraid is a drive dying. kopia is everything else: a file deleted by
# mistake, a bad write synced into parity, the building. It is the only copy of
# den's data that is not in this room, and the only one encrypted with a key
# Backblaze does not have.
#
# Everything below reads its credentials from /run/den/secrets, so it chains
# after the secrets path rather than running beside it.
exec "kopia-v1" {
	cmd => deploy.readfile("/files/scripts/kopia-install.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/kopia-v1",

	Depend => Exec["den-secrets-units-v1"],
}

file "/usr/local/bin/den-kopia" {
	state => "exists",
	content => deploy.readfile("/files/usr/local/bin/den-kopia"),
	mode => "0755",

	Depend => Exec["kopia-v1"],
}

file "/etc/systemd/system/kopia-backup.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/kopia-backup.service"),
	mode => "0644",

	Depend => File["/usr/local/bin/den-kopia"],
}

file "/etc/systemd/system/kopia-backup.timer" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/kopia-backup.timer"),
	mode => "0644",

	Depend => File["/etc/systemd/system/kopia-backup.service"],
}

# The drill is not optional extra credit. A backup nobody has restored from is
# a belief, and the way that belief is usually tested is the day it matters.
file "/usr/local/bin/den-kopia-drill" {
	state => "exists",
	content => deploy.readfile("/files/usr/local/bin/den-kopia-drill"),
	mode => "0755",

	Depend => File["/etc/systemd/system/kopia-backup.timer"],
}

file "/etc/systemd/system/kopia-restore-drill.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/kopia-restore-drill.service"),
	mode => "0644",

	Depend => File["/usr/local/bin/den-kopia-drill"],
}

file "/etc/systemd/system/kopia-restore-drill.timer" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/kopia-restore-drill.timer"),
	mode => "0644",

	Depend => File["/etc/systemd/system/kopia-restore-drill.service"],
}

# Bump the version for a unit change; the sentinel is what makes this run once.
exec "kopia-units-v1" {
	cmd => deploy.readfile("/files/scripts/kopia-units.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/kopia-units-v1",

	Depend => File["/etc/systemd/system/kopia-restore-drill.timer"],
}

# File shares.
#
# Samba is in the host layer rather than a container because it serves the
# array, and a container that bind mounts the whole array to re-export it is a
# container in name only.
#
# It listens on the tailnet alone. There is no LAN share and no guest access,
# which is also why the Time Machine target can sit on the same host.
file "/etc/samba/smb.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/samba/smb.conf"),
	mode => "0644",

	Depend => Exec["kopia-units-v1"],
}

file "/usr/local/bin/den-samba-user" {
	state => "exists",
	content => deploy.readfile("/files/usr/local/bin/den-samba-user"),
	mode => "0755",

	Depend => File["/etc/samba/smb.conf"],
}

file "/etc/systemd/system/den-samba.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-samba.service"),
	mode => "0644",

	Depend => File["/usr/local/bin/den-samba-user"],
}

# Enabled, not started: the password comes from the secrets path, which is not
# populated until `den apply` has written the sealed key.
exec "samba-units-v1" {
	cmd => deploy.readfile("/files/scripts/samba-units.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/samba-units-v1",

	Depend => File["/etc/systemd/system/den-samba.service"],
}

# The front door.
#
# Caddy is here before the first quadlet on purpose: with it in place, adding
# an app is a reverse_proxy line in one file, and without it every app invents
# its own port and its own answer to who can reach it.
exec "caddy-v2" {
	cmd => deploy.readfile("/files/scripts/caddy-install.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/caddy-v2",

	Depend => Exec["samba-units-v1"],
}

# den's own, because the apt package's unit went with the apt package. This is
# also where the sealed GCP key reaches Caddy for the ACME DNS challenge.
file "/etc/systemd/system/caddy.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/caddy.service"),
	mode => "0644",

	Depend => Exec["caddy-v2"],
}

file "/etc/caddy/Caddyfile" {
	state => "exists",
	content => deploy.readfile("/files/etc/caddy/Caddyfile"),
	mode => "0644",

	Depend => File["/etc/systemd/system/caddy.service"],
}

file "/srv/www/" {
	state => "exists",

	Depend => File["/etc/caddy/Caddyfile"],
}

file "/srv/www/den/" {
	state => "exists",

	Depend => File["/srv/www/"],
}

# What den.mklv.tech serves. A list of links, not an app: the dashboard that
# replaces it can come when there is more than one thing to list.
file "/srv/www/den/index.html" {
	state => "exists",
	content => deploy.readfile("/files/srv/www/den/index.html"),
	mode => "0644",

	Depend => File["/srv/www/den/"],
}

file "/etc/systemd/system/den-caddy-reload.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-caddy-reload.service"),
	mode => "0644",

	Depend => File["/srv/www/den/index.html"],
}

file "/etc/systemd/system/den-caddy-reload.path" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-caddy-reload.path"),
	mode => "0644",

	Depend => File["/etc/systemd/system/den-caddy-reload.service"],
}

exec "caddy-units-v2" {
	cmd => deploy.readfile("/files/scripts/caddy-units.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/caddy-units-v2",

	Depend => File["/etc/systemd/system/den-caddy-reload.path"],
}

# What the host looks like from the outside.
#
# Beszel, not netdata: netdata was dropped from the Ubuntu archive before
# 26.04 and has no replacement there, and the thing den actually needs watched
# is systemd. Its real failures are kopia-backup.timer not firing,
# den-samba.service dying and den-reconcile wedging. Beszel reports unit
# state, restart counts and journal tails; netdata never did.
#
# The agent is in the host layer because its whole job is to see the host.
# SMART, hwmon and the journal through a container namespace is fighting the
# isolation the container exists for. The hub it reports to is a quadlet in
# the user layer, where every other app lives.
exec "beszel-agent-v1" {
	cmd => deploy.readfile("/files/scripts/beszel-agent.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/beszel-agent-v1",

	Depend => Exec["caddy-units-v2"],
}

exec "beszel-hub-v1" {
	cmd => deploy.readfile("/files/scripts/beszel-hub.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/beszel-hub-v1",

	Depend => Exec["beszel-agent-v1"],
}

# In the host layer despite belonging to the hub: it has to be in place before
# the hub's first start, and the host layer runs first.
file "/srv/appdata/beszel/config.yml" {
	state => "exists",
	content => deploy.readfile("/files/srv/appdata/beszel/config.yml"),
	owner => "dmikalova",
	group => "dmikalova",
	mode => "0644",

	Depend => Exec["beszel-hub-v1"],
}

file "/etc/systemd/system/beszel-agent.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/beszel-agent.service"),
	mode => "0644",

	Depend => File["/srv/appdata/beszel/config.yml"],
}

exec "beszel-agent-units-v1" {
	cmd => deploy.readfile("/files/scripts/beszel-agent-units.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/beszel-agent-units-v1",

	Depend => File["/etc/systemd/system/beszel-agent.service"],
}

