# den's root layer.
#
# Only things that need root belong here. Everything den actually serves is a
# rootless Podman quadlet living in the login user's home, started by that
# user's own systemd. What root owns is the ground those quadlets stand on:
# packages, mounts, lingering, and a few one shot enablements.
#
# mgmt converges this once and exits. See docs/bootstrap.md.

import "deploy"
import "os"

# The whole host package set. If this list grows much past twenty, something
# that should be a container has leaked into the host.
pkg [
	"btrfs-progs",
	"mergerfs",
	"ncurses-term",
	"smartmontools",
	"snapper",
	"snapraid",
	"systemd-zram-generator",
	"ufw",
	"unattended-upgrades",
] {
	state => "installed",
	allowunsupported => os.is_family_debian() ?: true,

	# systemd's apt-daily.timer can hold the apt lock when this runs, and
	# PackageKit cannot wait for it. apt-daily finishes in seconds, so retry.
	Meta:retry => 3,
	Meta:delay => 15000,
}

# Sentinels for the exec resources below, which change state that is not a file.
#
# No mode: mgmt 1.1.0 compares a directory's os.FileMode, which carries ModeDir,
# against a bare octal, so the two never match and it chmods in a loop until the
# converger gives up. Fixed upstream after 1.1.0. mkdir already gives 0755.
file "/var/lib/den/" {
	state => "exists",
}

# The install asks for kernel-crash-dumps to be off and does not get it, so
# take the reservation back here. A crash dump is of no use on a host whose
# recovery plan is to rebuild it from this file.
pkg "kdump-tools" {
	state => "uninstalled",
}

# Without this, the drives expose no hwmon and their temperature can only be
# read by shelling out to smartctl.
file "/etc/modules-load.d/drivetemp.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/modules-load.d/drivetemp.conf"),
	mode => "0644",
}

# Compressed swap in RAM, on top of the disk swapfile the install lays down.
# zram takes the higher priority, so cold anonymous pages are compressed into
# RAM and the SSD is only reached once zram fills. The win is not capacity:
# it is that the kernel can evict pages nothing will touch again and give the
# memory to page cache.
file "/etc/systemd/zram-generator.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/zram-generator.conf"),
	mode => "0644",
}

# Swapping to RAM is cheap enough that the kernel should do it readily. The
# stock 60 is tuned for swap that costs a disk seek.
file "/etc/sysctl.d/99-den-swap.conf" {
	state => "exists",
	content => deploy.readfile("/files/etc/sysctl.d/99-den-swap.conf"),
	mode => "0644",
}

# GRUB's stock recordfail pause is 30 seconds, which a headless box spends
# waiting for a keystroke nobody is there to press.
#
# Deliberately no ahci.mask_port_map. Cheap SATA cards sometimes advertise far
# more ports than they wire up and the kernel wastes minutes probing phantom
# ones, but the card fitted here reports its 8 real ports honestly, and a mask
# would only discard working ports. It is also global: it hits the chipset's
# own controller too. Measure before ever reintroducing it:
#   journalctl -k | grep -E 'masking port_map|ports implemented'
file "/etc/default/grub.d/99-den.cfg" {
	state => "exists",
	content => deploy.readfile("/files/etc/default/grub.d/99-den.cfg"),
	mode => "0644",
}

# grub.cfg is generated, so writing the drop-in is only half the job. The mtime
# comparison reruns this whenever the drop-in is newer and never otherwise,
# which also makes it safe if mgmt orders the file write after this exec.
exec "update-grub" {
	cmd => "update-grub",
	shell => "/bin/bash",
	ifcmd => "! test /boot/grub/grub.cfg -nt /etc/default/grub.d/99-den.cfg",
	ifshell => "/bin/bash",
}

# en_DK is the ISO 8601 locale: 24 hour clock and YYYY-MM-DD dates. Only
# LC_TIME takes it, so messages stay in English.
exec "locales-v1" {
	cmd => "locale-gen en_US.UTF-8 en_DK.UTF-8 && update-locale LC_TIME=en_DK.UTF-8 && touch /var/lib/den/locales-v1",
	shell => "/bin/bash",
	creates => "/var/lib/den/locales-v1",
}

# The install writes this too, because den cannot reach mgmt without it. mgmt
# keeps it from drifting. The content must match the installer's exactly.
file "/etc/sudoers.d/den" {
	state => "exists",
	content => deploy.readfile("/files/etc/sudoers.d/den"),
	mode => "0440",
}

# Without lingering, the login user's quadlets stop at logout and never come
# back after a reboot. Nothing reports this; the services are simply absent.
exec "enable-linger" {
	cmd => "loginctl enable-linger dmikalova",
	shell => "/bin/bash",
	creates => "/var/lib/systemd/linger/dmikalova",
}

# Enrolment is den apply's last step, not this one: the key cannot live in a
# public repo. This only installs the package.
exec "tailscale-v1" {
	cmd => deploy.readfile("/files/scripts/tailscale-install.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/tailscale-v1",
}

# Drives idle down on their own; smartd is what notices one dying first.
svc "smartd" {
	state => "running",
	startup => "enabled",
}

# Bump the sentinel version to reapply.
exec "ufw-policy-v1" {
	cmd => deploy.readfile("/files/scripts/ufw-policy.sh"),
	shell => "/bin/bash",
	creates => "/var/lib/den/ufw-policy-v1",
}

# systemd already runs the upgrades, on apt-daily.timer and
# apt-daily-upgrade.timer. All that is missing is policy, and policy is a
# config file, so mgmt owns it and runs nothing itself.
file "/etc/apt/apt.conf.d/20auto-upgrades" {
	state => "exists",
	content => deploy.readfile("/files/etc/apt/apt.conf.d/20auto-upgrades"),
	mode => "0644",
}

# Stock Allowed-Origins is security only, which leaves ordinary bug fixes in
# -updates to rot. Apt appends to list options, so this widens 50unattended
# rather than replacing it. Remove-Unused does the job autoremove --purge used
# to do in bootstrap, including old kernels.
#
# Automatic-Reboot stays false until three things are true, in order:
#   1. the LUKS TPM token is confirmed bound to PCR 7 only, so a kernel update
#      cannot invalidate it and strand den at a passphrase prompt
#   2. snapper is configured AND the /boot problem is solved: /boot is a
#      separate partition, so rolling @ back to before a kernel update leaves
#      a kernel in /boot whose modules are gone from /lib/modules
#   3. a dead man notification exists to report the host did not come back
file "/etc/apt/apt.conf.d/52den-unattended" {
	state => "exists",
	content => deploy.readfile("/files/etc/apt/apt.conf.d/52den-unattended"),
	mode => "0644",
}

# The drift catcher.
file "/usr/local/bin/den-reconcile" {
	state => "exists",
	content => deploy.readfile("/files/usr/local/bin/den-reconcile"),
	mode => "0755",
}

file "/etc/systemd/system/den-reconcile.service" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-reconcile.service"),
	mode => "0644",
}

file "/etc/systemd/system/den-reconcile.timer" {
	state => "exists",
	content => deploy.readfile("/files/etc/systemd/system/den-reconcile.timer"),
	mode => "0644",
}

# Not a svc resource: mgmt appends .service to the name, so it looks for
# den-reconcile.timer.service and fails. The wants symlink is the real state.
exec "den-reconcile-timer-v1" {
	cmd => "systemctl daemon-reload && systemctl enable --now den-reconcile.timer",
	shell => "/bin/bash",
	creates => "/etc/systemd/system/timers.target.wants/den-reconcile.timer",

	Depend => File["/etc/systemd/system/den-reconcile.timer"],
}
