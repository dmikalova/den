# den's user layer.
#
# Everything den serves runs here: rootless Podman quadlets in the login user's
# home, started by that user's own systemd. The root layer owns the ground they
# stand on and nothing more.
#
# This converges as dmikalova, with its own state under ~/.local/state, because
# its resources are that user's files and that user's units. Converging it as
# root would leave them owned by root, which is the one reliable way to stop a
# rootless service from starting.
#
# den-reconcile runs this after the root layer. See ../README.md.

import "deploy"

# The quadlet directory. mgmt writes a file, it does not build the path to it,
# so the parents have to be resources too.
#
# No mode on the directories. Setting one makes the resource flap: mgmt chmods,
# sees its own change, and chmods again, several times a second for the life of
# the run. The default a fresh directory gets is already 0755.
file "/home/dmikalova/.config/" {
	state => "exists",
}

file "/home/dmikalova/.config/containers/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/"],
}

file "/home/dmikalova/.config/containers/systemd/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/"],
}

# Hardening for every .container file, merged in by quadlet. A new service is
# hardened by existing, rather than by someone remembering to copy four lines.
file "/home/dmikalova/.config/containers/systemd/container.d/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/"],
}

file "/home/dmikalova/.config/containers/systemd/container.d/10-hardening.conf" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/container.d/10-hardening.conf"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/container.d/"],
}

file "/home/dmikalova/.config/containers/systemd/ollama.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/ollama.container"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/container.d/10-hardening.conf"],
}

# The one exception to the shared hardening. See the file for why.
file "/home/dmikalova/.config/containers/systemd/ollama.container.d/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/ollama.container"],
}

file "/home/dmikalova/.config/containers/systemd/ollama.container.d/10-writable-rootfs.conf" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/ollama.container.d/10-writable-rootfs.conf"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/ollama.container.d/"],
}

file "/home/dmikalova/.config/containers/systemd/beszel.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/beszel.container"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/ollama.container.d/10-writable-rootfs.conf"],
}

# ollama's bind mount source. podman does not make it, and a missing source
# fails the container start. The root layer gives /srv/cache/models to this
# user.
file "/srv/cache/models/ollama/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/beszel.container"],
}

# The Paseo instances, personal and work. Same image, separate credentials
# and separate state. See docs/paseo.md.
file "/home/dmikalova/.config/containers/systemd/paseo.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/paseo.container"),
	mode => "0644",

	Depend => File["/srv/cache/models/ollama/"],
}

file "/home/dmikalova/.config/containers/systemd/paseo-work.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/paseo-work.container"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/paseo.container"],
}

# Nested rootless podman for both instances. One file, see it for why.
file "/home/dmikalova/.config/containers/systemd/paseo.container.d/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/paseo-work.container"],
}

file "/home/dmikalova/.config/containers/systemd/paseo.container.d/20-nested-podman.conf" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/paseo.container.d/20-nested-podman.conf"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/paseo.container.d/"],
}

file "/home/dmikalova/.config/containers/systemd/paseo-work.container.d/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/paseo.container.d/20-nested-podman.conf"],
}

file "/home/dmikalova/.config/containers/systemd/paseo-work.container.d/20-nested-podman.conf" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/paseo.container.d/20-nested-podman.conf"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/paseo-work.container.d/"],
}

# The bind mount sources. The root layer makes the per-app directories in the
# areas and gives them to this user.
file "/srv/cache/paseo/workspace/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/paseo-work.container.d/20-nested-podman.conf"],
}

file "/srv/cache/paseo/worktrees/" {
	state => "exists",

	Depend => File["/srv/cache/paseo/workspace/"],
}

file "/srv/cache/paseo/cache/" {
	state => "exists",

	Depend => File["/srv/cache/paseo/worktrees/"],
}

file "/srv/cache/models/paseo/" {
	state => "exists",

	Depend => File["/srv/cache/paseo/cache/"],
}

file "/srv/cache/paseo-work/workspace/" {
	state => "exists",

	Depend => File["/srv/cache/models/paseo/"],
}

file "/srv/cache/paseo-work/worktrees/" {
	state => "exists",

	Depend => File["/srv/cache/paseo-work/workspace/"],
}

file "/srv/cache/paseo-work/cache/" {
	state => "exists",

	Depend => File["/srv/cache/paseo-work/worktrees/"],
}

file "/srv/cache/models/paseo-work/" {
	state => "exists",

	Depend => File["/srv/cache/paseo-work/cache/"],
}

# The vpn pod: gluetun holds the AirVPN tunnel, and qBittorrent and slskd have
# no way out but through it. See docs/vpn.md.
file "/home/dmikalova/.config/containers/systemd/vpn.pod" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/vpn.pod"),
	mode => "0644",

	Depend => File["/srv/cache/models/paseo-work/"],
}

file "/home/dmikalova/.config/containers/systemd/gluetun.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/gluetun.container"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/vpn.pod"],
}

file "/home/dmikalova/.config/containers/systemd/qbittorrent.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/qbittorrent.container"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/gluetun.container"],
}

file "/home/dmikalova/.config/containers/systemd/slskd.container" {
	state => "exists",
	content => deploy.readfile("/files/containers/systemd/slskd.container"),
	mode => "0644",

	Depend => File["/home/dmikalova/.config/containers/systemd/qbittorrent.container"],
}

# The bind mount sources. dmikalova owns /mnt/storage. The root layer makes
# /srv/cache/slskd and gives it to this user.
file "/srv/cache/slskd/incomplete/" {
	state => "exists",

	Depend => File["/home/dmikalova/.config/containers/systemd/slskd.container"],
}

file "/mnt/storage/downloads/" {
	state => "exists",

	Depend => File["/srv/cache/slskd/incomplete/"],
}

file "/mnt/storage/downloads/torrents/" {
	state => "exists",

	Depend => File["/mnt/storage/downloads/"],
}

file "/mnt/storage/downloads/soulseek/" {
	state => "exists",

	Depend => File["/mnt/storage/downloads/torrents/"],
}

# The music library. slskd shares it, read-only.
file "/mnt/storage/music/" {
	state => "exists",

	Depend => File["/mnt/storage/downloads/soulseek/"],
}

exec "quadlets-v18" {
    # Three tries, then report. An exec that cannot succeed will never
    # succeed, and the default is to retry it until the unit times out.
    Meta:retry => 3,
    Meta:delay => 15000,
    cmd => deploy.readfile("/files/scripts/quadlets.sh"),
    shell => "/bin/bash",
    creates => "/home/dmikalova/.local/state/den/quadlets-v18",

	Depend => File["/mnt/storage/music/"],
}
