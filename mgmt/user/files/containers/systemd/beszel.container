[Unit]
# The dashboard half of the monitor. The agent that collects the metrics is in
# the host layer, because reading SMART, sensors and the journal through a
# container namespace is fighting the isolation the container exists for.
# The data is a PocketBase database, so it sits on /srv/appdata and is backed
# up with everything else there.
RequiresMountsFor=/srv/appdata
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=beszel
# Pinned, matching the agent version in files/scripts/beszel-agent.sh. Hub and
# agent speak a versioned protocol, so they move together or not at all.
Image=docker.io/henrygd/beszel:0.21.0
Volume=/srv/appdata/beszel:/beszel_data
# No login form. Reaching this at all already means passing Caddy's tailnet
# check and ufw, and the hub binds loopback, so a second password buys nothing
# and costs a reinstall step. AUTO_LOGIN is undocumented, so check it still
# exists in internal/hub/api.go when bumping the image.
Environment=AUTO_LOGIN=den@mklv.tech
# Creates the account during the hub's first migration, which is the only
# moment it can be made without a form. The password is generated by
# files/scripts/beszel-hub.sh and never typed.
Environment=USER_EMAIL=den@mklv.tech
EnvironmentFile=/srv/appdata/beszel/hub.env
# Loopback only. Caddy publishes it on the tailnet; nothing reaches this port
# from off the host.
PublishPort=127.0.0.1:8090:8090

[Service]
Restart=always

[Install]
WantedBy=default.target
