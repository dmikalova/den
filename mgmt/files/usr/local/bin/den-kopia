#!/bin/bash
# den's offsite copy.
#
# snapraid covers a drive that dies. It does not cover a file deleted by
# mistake, a bad write that gets synced into parity, or the building. kopia
# does, because the copy is in another state and the history is addressable.
#
# Encryption is client side, so Backblaze holds ciphertext and KOPIA_PASSWORD
# is the whole of what makes it readable. The password is minted by the
# infrastructure repo and never typed. systemd hands it to this script, and
# kopia keeps a copy beside its config so a root shell can restore without it.
# That copy is root only, on the LUKS volume. Root on den can read the secrets
# directory anyway, so it adds no exposure.
#
# Run by kopia-backup.service, which is what grants the credentials. Running it
# by hand needs that service's environment, so run the service instead:
#   systemctl start kopia-backup.service
#
# The bucket is a Backblaze B2 bucket reached over Backblaze's S3-compatible
# endpoint, not kopia's b2 provider. B2's native API is closed to the key this
# host holds, and kopia has deprecated that provider anyway.
set -euo pipefail

creds=${CREDENTIALS_DIRECTORY:?run this through kopia-backup.service}

export KOPIA_PASSWORD
KOPIA_PASSWORD=$(<"$creds/kopia-password")
bucket=$(<"$creds/b2-bucket")
endpoint=$(<"$creds/b2-endpoint")
region=$(<"$creds/b2-region")
key_id=$(<"$creds/b2-key-id")
key=$(<"$creds/b2-key")

# Not /root/.config. The state directory is the unit's, so a rebuild that keeps
# /var/lib keeps the repository connection, and nothing here depends on which
# account happens to run it.
export KOPIA_CONFIG_PATH=/var/lib/kopia/repository.config
export KOPIA_CHECK_FOR_UPDATES=false
cache=/var/cache/kopia

# Paths that are worth money or time to lose. See docs/storage.md.
#
# /srv/cache is deliberately absent: model weights and image layers are
# downloads, and paying to store a copy of something the internet will hand
# back is the easiest way to make a backup too expensive to keep.
#
# /srv/db is absent too. A copy of running database files is only crash
# consistent; the dump each database writes to /srv/db-dumps is the backup.
sources=(
	/srv/appdata
	/srv/db-dumps
	/mnt/storage
)

connect() {
	# connect first, create second. The repository usually exists, and `create`
	# against an existing one is an error rather than a no-op, so the order
	# decides whether the normal path is quiet.
	if kopia repository connect s3 \
		--bucket="$bucket" \
		--endpoint="$endpoint" \
		--region="$region" \
		--access-key="$key_id" \
		--secret-access-key="$key" \
		--cache-directory="$cache" \
		--no-check-for-updates 2>/dev/null; then
		return 0
	fi

	echo "no repository at s3://$bucket; creating one"
	kopia repository create s3 \
		--bucket="$bucket" \
		--endpoint="$endpoint" \
		--region="$region" \
		--access-key="$key_id" \
		--secret-access-key="$key" \
		--cache-directory="$cache" \
		--no-check-for-updates
}

# The config file records the connection, not the credentials, so this is a
# connection check rather than a login check.
if ! kopia repository status >/dev/null 2>&1; then
	connect
fi

# Policy lives in the repository, so this is both "set it" and "put it back".
# Cheap enough to assert every run, which is the point: a policy edited by hand
# during an incident should not survive the incident.
#
# Compression: B2 storage is the running cost, and the CPU is idle at 22:00.
# `kopia benchmark compression` on this host (Ryzen 7 7700, 16 threads):
#   zstd-fastest              5.0 GB/s  baseline size
#   zstd (level 3)            3.6 GB/s   8% smaller
#   zstd-better-compression   1.3 GB/s  16% smaller  <- this
#   zstd-best-compression     0.6 GB/s  20% smaller, deprecated in kopia
# 1.3 GB/s is still several times what the data drives can read, so the backup
# stays disk- or upload-bound. A change applies to new data only.
#
# node_modules/ and .terraform/ are reinstalled from a lockfile, never restored.
kopia policy set --global \
	--compression=zstd-better-compression \
	--keep-latest=5 \
	--keep-hourly=0 \
	--keep-daily=14 \
	--keep-weekly=8 \
	--keep-monthly=12 \
	--keep-annual=3 \
	--add-ignore='.snapshots/' \
	--add-ignore='lost+found/' \
	--add-ignore='node_modules/' \
	--add-ignore='.terraform/' \
	--add-ignore='*.part' \
	--add-ignore='*.tmp'

# A Time Machine sparsebundle is already a backup, and it churns: every Mac
# backup rewrites bands, so uploading it would cost more than everything else
# here combined to store a second copy of a copy.
kopia policy set /mnt/storage --add-ignore='/timemachine/'

# Torrent and Soulseek downloads can be fetched again. What is worth keeping
# is imported into /mnt/storage/music, which is backed up. See docs/vpn.md.
kopia policy set /mnt/storage --add-ignore='/downloads/'

# TEMPORARY. /mnt/storage/recover holds the drives being extracted from the old
# array; it is a second copy of data that is already somewhere else, and paying
# to upload it twice is waste. /mnt/storage/restore holds the files pulled out
# of those images until they are checked; what is worth keeping moves to
# /mnt/storage/mess, and only then is it paid for. Delete this block once the
# extraction is done, or it will quietly exclude a real directory that happens
# to inherit the name. See docs/restore.md.
kopia policy set /mnt/storage --add-ignore='/recover/'
kopia policy set /mnt/storage --add-ignore='/restore/'

for src in "${sources[@]}"; do
	mountpoint -q "$src" || [ -d "$src" ] || {
		echo "missing source: $src" >&2
		exit 1
	}
	kopia snapshot create "$src"
done

# Quick maintenance only. Full maintenance rewrites pack blobs and can run for
# hours, which is a poor fit for a unit that holds a credential and a timer
# slot; kopia schedules the full pass itself once the quick pass tells it to.
kopia maintenance run

kopia repository status
