#!/bin/bash
# den pulls its own config; nothing outside pushes to it. The pull drops to the
# owning user so git does not refuse the checkout as dubiously owned, then mgmt
# converges as root.
set -euo pipefail

# One reconcile at a time. The daily timer and the CI apply can land together,
# and two mgmt runs cannot share etcd's port on 2380: the loser dies on bind and
# reports a failed deploy. Queue instead of exiting, because the run already in
# flight pulled before the commit that triggered this one.
exec 9>/run/den-reconcile.lock
flock -w 900 9 || {
	echo "another reconcile held the lock for 15m, giving up" >&2
	exit 1
}

runuser -u dmikalova -- git -C /srv/den-config pull --ff-only

# den-secrets only fetches at boot and then stays active, so a key added to the
# secret in Secret Manager is invisible until a reboot. Reconcile is the drift
# catcher, and a stale secret is drift.
systemctl restart den-secrets.service

cd /srv/den-config/mgmt
# --no-autoedges is not an optimisation, it is required. Auto-edge computation
# on this graph runs for minutes, and the converger counts that time as idle, so
# --converged-exit fires before a single resource is applied. The run then exits
# 0 having changed nothing. bootstrap.go has always passed the flag; this script
# did not, which is why scheduled reconciles silently skipped work.
#
# --converger-timeout is a quiescence window, not a per-resource deadline: mgmt
# exits once the whole graph has been still for this many seconds. 30s costs 25
# extra seconds on an idle run and buys a margin against the same class of bug.
mgmt run --no-autoedges --converger-timeout 30 --converged-exit lang ./metadata.yaml

# The user layer. It converges as the login user because its resources are that
# user's files and that user's units, and root would own both if root made
# them. It runs second because its quadlets depend on what root installs:
# lingering, the mounts, the CDI spec.
#
# runuser does not build a login environment, so mgmt gets HOME and the user
# bus explicitly. Without XDG_RUNTIME_DIR, systemctl --user has no bus to talk
# to and the quadlet script fails on the first line.
uid="$(id -u dmikalova)"
cd /srv/den-config/mgmt/user
exec runuser -u dmikalova -- env \
	HOME=/home/dmikalova \
	XDG_RUNTIME_DIR="/run/user/${uid}" \
	mgmt run --no-autoedges --converger-timeout 30 --converged-exit \
	--prefix /home/dmikalova/.local/state/mgmt lang ./metadata.yaml
