#!/bin/bash
# den pulls its own config; nothing outside pushes to it. The pull drops to the
# owning user so git does not refuse the checkout as dubiously owned, then mgmt
# converges as root.
set -euo pipefail
runuser -u dmikalova -- git -C /srv/den-config pull --ff-only
cd /srv/den-config/mgmt
# --converger-timeout is a quiescence window, not a per-resource deadline: mgmt
# exits once the whole graph has been still for this many seconds. Anything the
# engine has not materialised by then is simply never applied, and the run still
# reports success. 5s was short enough to drop a package. 30s costs 25 extra
# seconds on an idle run and buys a wide margin.
exec mgmt run --converger-timeout 30 --converged-exit lang ./metadata.yaml
