# den's front door.
#
# Everything with a web interface on this host sits behind Caddy on localhost,
# so adding an app is a reverse_proxy line here rather than another port
# argued about in a quadlet.
#
# Plain HTTP, deliberately. The only path to this port is the tailnet, which
# is already encrypted, and terminating TLS would mean either a public name or
# a private CA every client has to be told about. When den.mklv.tech exists
# this gets a second site block with real certificates; the tailnet one stays.

{
	# Admin API on loopback, which is the default. It is left on because
	# `systemctl reload caddy` goes through it; turning it off would make a
	# config change a restart.
	admin localhost:2019
}

:80 {
	# ufw denies inbound from the LAN, so this should be unreachable from
	# anywhere but the tailnet already. This is the second answer: if the
	# firewall is ever reset by hand, the proxy still refuses.
	@offtailnet not remote_ip 100.64.0.0/10 127.0.0.1/8 ::1
	respond @offtailnet "not on the tailnet" 403 {
		close
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# Apps go here, one block each, each proxying to a localhost port.

	# Beszel, the monitoring hub. Unlike the rest of these it has a login of
	# its own, so the tailnet check above is a second lock rather than the
	# only one. It still binds 127.0.0.1: the login is not a reason to put a
	# PocketBase admin panel on the internet.
	handle_path /beszel/* {
		reverse_proxy 127.0.0.1:8090
	}
	redir /beszel /beszel/

	handle {
		respond "den" 200
	}
}
