# den's front door.
#
# Everything with a web interface on this host sits behind Caddy, so adding an
# app is a matcher here rather than another port argued about in a quadlet.
#
# Certificates are real, issued by ACME over DNS-01. Nothing reaches this host
# from the public internet, so HTTP-01 cannot be answered; den writes the
# challenge into its own Cloud DNS zone instead. See
# infrastructure/docs/adr/0010.
{
	# Admin API on loopback, which is the default. It is left on because
	# `systemctl reload caddy` goes through it; turning it off would make a
	# config change a restart.
	admin localhost:2019
}

# Both names, because a wildcard certificate does not cover the name it is a
# wildcard of.
den.mklv.tech, *.den.mklv.tech {
	tls {
		dns googleclouddns {
			# Inline, not an env var: `caddy validate` runs without the
			# unit's environment, and the plugin rejects an empty id.
			gcp_project mklv-infrastructure
		}
	}

	# The names resolve publicly; the addresses behind them are tailnet-only.
	# ufw denies inbound from the LAN, so this should be unreachable from
	# anywhere but the tailnet already. This is the second answer: if the
	# firewall is ever reset by hand, the proxy still refuses.
	@offtailnet not remote_ip 100.64.0.0/10 127.0.0.1/8 ::1
	respond @offtailnet "not on the tailnet" 403 {
		close
	}

	# To the journal, where every other log on this host already is. Not a
	# file: `caddy validate` runs as root and creates the log as 0600 root,
	# and caddy runs as caddy, so the next reload cannot open it.
	log {
		output stderr
	}

	# Apps go here, one matcher each, each proxying to a localhost port. A
	# name rather than a path: an app that assumes it owns / is the common
	# case, and rewriting its links is work that never ends.
	@beszel host beszel.den.mklv.tech
	handle @beszel {
		reverse_proxy 127.0.0.1:8090
	}

	# den.mklv.tech itself, and anything under it without an app.
	handle {
		root * /srv/www/den
		file_server
	}
}

# The tailnet IP and the MagicDNS name still have to lead somewhere, and this
# is the way back in if a renewal fails. A redirect rather than a second copy
# of the site: two block bodies serving the same apps is how a stale one
# happens.
:80 {
	redir https://den.mklv.tech{uri} permanent
}
