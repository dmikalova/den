[Unit]
Description=Pooled storage across the snapraid data drives
Requires=mnt-disk1.mount mnt-disk2.mount mnt-disk3.mount
After=mnt-disk1.mount mnt-disk2.mount mnt-disk3.mount
Before=local-fs.target

[Mount]
# The branches are a subdirectory of each drive, not the drive root, so that
# snapper's .snapshots subvolume sits beside the branch instead of inside it.
# A branch at the drive root makes every snapshot directory appear in the pool.
What=/mnt/disk1/data:/mnt/disk2/data:/mnt/disk3/data
Where=/mnt/storage
Type=fuse.mergerfs
# pfrd spreads new files across the drives in proportion to their free space,
# which keeps any one drive from becoming the only copy of a whole directory.
# minfreespace leaves each drive room for snapraid to work and for a file to be
# moved off a full drive.
Options=category.create=pfrd,minfreespace=100G,moveonenospc=true,dropcacheonclose=true,cache.files=partial,allow_other,fsname=storage

[Install]
WantedBy=local-fs.target
