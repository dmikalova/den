[Unit]
Description=Regenerate the NVIDIA CDI spec
# The spec names driver library versions, so an unattended driver upgrade
# leaves it stale and every GPU container fails to start. Regenerating each
# boot is cheaper than noticing that the hard way.
ConditionPathExists=/usr/bin/nvidia-ctk

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml

[Install]
WantedBy=multi-user.target
