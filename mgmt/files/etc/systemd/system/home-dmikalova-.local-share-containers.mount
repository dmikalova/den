[Unit]
Description=Container image and layer store, bound from /srv/cache/containers
# A bind mount keeps podman on its default path, so nothing has to be told
# where the store is. The store is on @cache because image layers are
# re-pullable and not worth snapshots or a backup. Nested under @home it would
# ride along with every snapshot of /home.
Before=local-fs.target
RequiresMountsFor=/home /srv/cache

[Mount]
What=/srv/cache/containers
Where=/home/dmikalova/.local/share/containers
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
