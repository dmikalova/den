[Unit]
Description=Fetch den's runtime secret and explode it for other units
Wants=network-online.target
After=network-online.target

# Every unit that wants a credential orders itself after this one. The fetch
# falls back to a sealed cache, so an outage delays the boot rather than
# failing it, and the unit succeeds either way.
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes

# The service account key on disk is sealed to this TPM. systemd decrypts it
# and hands the plaintext to this process alone, so den never talks to the TPM
# and the key is never written anywhere readable.
LoadCredentialEncrypted=gcp-key:/etc/den/credentials/gcp-key.cred

ExecStart=/usr/local/bin/den secrets fetch

# /run/den is tmpfs, so the exploded secrets never reach the disk and do not
# survive a reboot. 0700 root keeps them out of reach of every service account.
RuntimeDirectory=den/secrets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# The cache is sealed, so losing it costs one offline boot rather than a
# secret. StateDirectory= creates it with the right owner on first start.
StateDirectory=den
StateDirectoryMode=0700

# Bounded because a unit that wants a credential waits on this one. A hung
# fetch should cost a boot delay, not the boot.
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
